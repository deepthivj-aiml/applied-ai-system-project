# Copy to .env and set the PostgreSQL connection for dog reports.
DATABASE_URL=postgresql://pawpal_app:change-me@localhost:5432/pawpal_app
OPENAI_API_KEY=
OPENAI_VLM_MODEL=gpt-6.1-terra
PAWPAL_PUBLIC_URL=http://localhost:8501
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional local demo addresses. Keep real addresses only in ignored .env.
PAWPAL_DEMO_LOST_EMAIL=
PAWPAL_DEMO_FOUND_EMAIL=
